config {
  type: "table",
  schema: "silver",
  description: "Dimensão vendedores - enriquecida com concessionaria, cidade e estado",
  tags: ["silver", "dimension"]
}

SELECT
  v.id_vendedores,
  v.nome AS vendedor,
  v.id_concessionarias,
  c.concessionaria,
  ci.cidade,
  e.estado,
  e.sigla,
  v.data_inclusao,
  v.data_atualizacao,
  CURRENT_TIMESTAMP() AS data_processamento
FROM bronze.vendedores v
LEFT JOIN bronze.concessionarias c ON v.id_concessionarias = c.id_concessionarias
LEFT JOIN bronze.cidades ci ON c.id_cidades = ci.id_cidades
LEFT JOIN bronze.estados e ON ci.id_estados = e.id_estados
